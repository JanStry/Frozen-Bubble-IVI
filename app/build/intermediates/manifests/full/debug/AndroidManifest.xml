<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.jfedor.frozenbubble"
    android:installLocation="preferExternal"
    android:versionCode="8"
    android:versionName="1.7" >

    <uses-sdk
        android:minSdkVersion="10"
        android:targetSdkVersion="10" />

    <uses-permission android:name="com.ygomi.permission.IVI_MODIFY_STATE_AUDIO" />

    <application
        android:icon="@drawable/app_frozen_bubble"
        android:label="@string/app_name" >
        <meta-data
            android:name="ivi.audio"
            android:value="true" />

        <activity
            android:name="org.jfedor.frozenbubble.FrozenBubble"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|keyboardHidden"
            android:label="@string/app_name"
            android:launchMode="singleInstance" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.jfedor.frozenbubble.GAME" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>